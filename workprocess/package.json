{
  "name": "workprocess",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "workprocess 领域插件（组合根，已并入内核）：两层快照 / 事件表 / 折叠 / 不变量 / 严格解码 / 服务 + 归属记录落宿主存储域 + 真人判定 + 回合边界驱动与续跑投递 + apply(ctx, config)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./invariant": {
      "types": "./dist/invariant-plugin.d.ts",
      "default": "./dist/invariant-plugin.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "zod": "^4.4.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
