{
  "name": "workprocess",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "workprocess 领域插件（组合根，已并入内核）：两层快照 / 事件表 / 折叠 / 不变量 / 严格解码 / 服务 + 归属记录落宿主存储域（含逐任务回合账）+ apply(ctx, config)——真人判定在 tool-workprocess、回合边界驱动在 workprocess-round-driver",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./invariant": {
      "types": "./dist/types/invariant.d.ts",
      "default": "./dist/invariant.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.js",
    "dist/invariant.js",
    "dist/types/**/*.d.ts",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "build:client": "tsdown --config tsdown.client.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "zod": "^4.4.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
