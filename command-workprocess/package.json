{
  "name": "dsh-command-workprocess",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "dsh-workprocess": "workspace:*",
    "workprocess-core": "workspace:*"
  },
  "description": "/work 命令行：查看与干预 workprocess 流程（与 @deepseek-ai/dsh-command-goal 同形）"
}
