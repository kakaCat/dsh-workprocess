{
  "name": "dsh-command-workprocess",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:bootstrap": "tsc -p tsconfig.build.json --noEmitOnError false || true",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.2.0-rc.1",
    "workprocess": "workspace:*"
  },
  "description": "/work 命令行：给目标即让 agent 拆阶段建流程，另可查看与干预（与 @deepseek-ai/dsh-command-goal 同形）"
}
